# AdapTeach Benchmark — environment configuration
# Copy this file to .env and fill in your values.
# Shell environment variables always take precedence over values here.

# ---------------------------------------------------------------------------
# Primary LLM provider: Ollama (local)
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# ---------------------------------------------------------------------------
# Gemini (optional — only needed when passing --provider gemini to ragas_eval.py)
# ---------------------------------------------------------------------------
# GEMINI_API_KEY=your_google_ai_studio_key_here
